    {
      "name": "04 - API Response validations",
      "item": [
        {
          "name": "GetCommentsByPostId Copy",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has 5 comments\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.length).to.eql(5);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"First comment has postID equal to one\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData[0].postId).to.eql(1);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"All comments belong to post 1\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    const allMatch = jsonData.every(comment => comment.postId === 1);\r",
                  "    pm.expect(allMatch).to.be.true;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
